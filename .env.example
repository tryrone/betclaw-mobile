# Public Expo environment values.
# Use the production backend for device builds.
EXPO_PUBLIC_API_URL=""

# Web OAuth client ID used by native Google Sign-In to request an ID token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""

# iOS OAuth client ID and reversed client ID from Google Cloud.
# Required before running native prebuilds for iOS Google Sign-In.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=""

# Set this to the EAS project id before testing push notifications outside a build
# where Constants.easConfig.projectId is already available.
# EXPO_PUBLIC_EXPO_PROJECT_ID=your-eas-project-id
